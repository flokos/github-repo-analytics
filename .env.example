# Template for the local environment file.
#
# Do not edit secrets in by hand: run `./scripts/bootstrap-env.sh`, which copies this file to `.env`
# and fills every empty value below with a freshly generated random secret.
# `.env` is git-ignored. Nothing in this template is a working credential.

# --- PostgreSQL (one instance, two logical databases) ---------------------------------------------
# Password of the `postgres` superuser, used only by the init script and for manual maintenance.
POSTGRES_SUPERUSER_PASSWORD=
# Django application data.
ANALYTICS_DB_NAME=analytics
ANALYTICS_DB_USER=analytics
ANALYTICS_DB_PASSWORD=
# Airflow metadata and the Airflow CeleryExecutor result backend.
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=

# --- Django ---------------------------------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# `api` is the Compose service name Airflow uses to reach Django.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
# Origins allowed to call the API cross-origin. The bundled dashboard is same-origin (nginx proxy),
# so this only matters for the Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Shared secret Airflow presents to Django's /api/internal/ endpoints.
INTERNAL_API_TOKEN=
# Throttle for POST /api/repositories/ (each call triggers one outbound GitHub request).
REPOSITORY_CREATE_THROTTLE=30/min

# --- GitHub ---------------------------------------------------------------------------------------
# Optional. Without a token GitHub allows 60 requests per hour per IP; with one, 5000.
# A fine-grained token with "Public repositories (read-only)" access and no extra permissions is enough.
GITHUB_TOKEN=

# --- Airflow --------------------------------------------------------------------------------------
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=
# These three must be identical in every Airflow container, otherwise the worker cannot
# authenticate against the API server.
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=
# Daily collection schedule (cron expression + IANA timezone). Read when the DAG file is parsed.
PIPELINE_SCHEDULE_CRON=0 6 * * *
PIPELINE_SCHEDULE_TIMEZONE=UTC
# Number of task slots in the Airflow Celery worker. Lower it on machines with little memory.
AIRFLOW_WORKER_CONCURRENCY=4

# --- Ports published on 127.0.0.1 -----------------------------------------------------------------
FRONTEND_PORT=3000
API_PORT=8000
AIRFLOW_PORT=8080
